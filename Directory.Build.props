<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Authors>GrpcEmbed contributors</Authors>
    <Version>4.1.3</Version>
    <PackageProjectUrl>https://github.com/develmax/DevelKit.GrpcEmbed</PackageProjectUrl>
    <PackageIcon>grpcembed-icon.png</PackageIcon>
    <PackageReleaseNotes>Cache the immutable configured channel origin instead of rebuilding it for every routed call. Preserve per-call paths, separate schema addresses, authentication, payload audit and masking hooks, cancellation, timeouts and handler ownership. Compatible with the 4.x wire format and schema hashes. This removes a small allocation; no stable end-to-end GET latency improvement is claimed. See CHANGELOG.md.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>grpc;aspnetcore;protobuf;mvc;rpc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/develmax/DevelKit.GrpcEmbed</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)MIGRATING-4.0.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets\grpcembed-icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
